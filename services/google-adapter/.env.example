# services/google-adapter — variables que lee este servicio.
# Copia a .env.local (ignorado por git) y ajusta. Las globales del proyecto
# viven en el .env.example de la raíz; aquí solo las de este servicio.

NODE_ENV=development

GOOGLE_ADAPTER_HOST=127.0.0.1
GOOGLE_ADAPTER_PORT=8200

# Conexión a PostgreSQL (mismo rol/base que core-api).
DATABASE_URL=postgresql://fisio:cambiar_en_local@localhost:5432/fisio_li

# OAuth de la app (Google Cloud Console → Credenciales → ID de cliente OAuth,
# tipo "Aplicación web"). El mismo client id/secret sirve para el consumidor
# del outbox (cuenta de Lina) y para el flujo opcional del paciente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8200/oauth/callback

# Refresh token de la cuenta de Lina (Workspace), obtenido UNA vez con
# `npm run setup-oauth` (ver README.md). Necesario para el consumidor del
# outbox: enviar correos y sincronizar el Calendar del negocio.
# El calendario a usar NO se configura acá: cada sede tiene el suyo en
# catalogo.sede.google_calendar_id (columna ya existente en el schema).
GOOGLE_REFRESH_TOKEN=

# ID de la hoja de cálculo donde se respalda cada reserva confirmada
# (pestaña "Reservas", se crea sola). Es el segmento entre /d/ y /edit en
# la URL de la hoja. Opcional: sin esto, esos eventos del outbox quedan
# reintentando hasta fallar, pero Gmail/Calendar siguen funcionando.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Cada cuánto se revisa integracion.outbox en busca de trabajo nuevo.
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_LOTE=20

TIMEZONE=America/Bogota
LOG_LEVEL=info
