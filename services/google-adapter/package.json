{
  "name": "@fisio-li/google-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Único servicio con credenciales OAuth de Google. Consume integracion.outbox (Gmail, Calendar de Lina) y expone el flujo de autorización opcional del Calendar personal del paciente. Ningún otro servicio, incluido n8n, habla con Google directamente.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "setup-oauth": "tsx --env-file-if-exists=.env.local src/setupOauth.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "precommit": "npm run lint && npm run typecheck && npm test -- --run"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "googleapis": "^178.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0"
  }
}
