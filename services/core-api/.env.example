# services/core-api — variables que lee este servicio.
# Copia a .env.local (ignorado por git) y ajusta. Las globales del proyecto
# viven en el .env.example de la raíz; aquí solo las de este servicio.

NODE_ENV=development

CORE_API_HOST=127.0.0.1
CORE_API_PORT=8000

# Conexión a PostgreSQL. En local, el rol fisio_core (ver db/migrations/schema.sql).
DATABASE_URL=postgresql://fisio:cambiar_en_local@localhost:5432/fisio_li
CORE_API_DB_POOL_MAX=10

# Secreto compartido entre servicios internos (bot -> nlu -> core-api).
# Obligatorio si NODE_ENV=production. Mínimo 16 caracteres.
INTERNAL_API_KEY=clave_compartida_entre_servicios_internos

TIMEZONE=America/Bogota

# Límites defensivos de la superficie HTTP
CORE_API_MAX_BODY_BYTES=16384
CORE_API_RATE_LIMIT_MAX=120
CORE_API_RATE_LIMIT_WINDOW=1 minute

LOG_LEVEL=info

# API de navegador (apps/web). Panel admin = un solo usuario (Lina).
WEB_ADMIN_USUARIO=
WEB_ADMIN_CLAVE=
WEB_SESSION_SECRET=
WEB_TOKEN_TTL_MIN=480
