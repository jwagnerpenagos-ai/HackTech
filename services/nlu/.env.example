# services/nlu — variables que lee este servicio.
# Copia a .env.local (ignorado por git) y ajusta. Las globales del proyecto
# viven en el .env.example de la raíz; aquí solo las de este servicio.

NODE_ENV=development

NLU_HOST=127.0.0.1
NLU_PORT=8100

# Secreto compartido entre servicios internos (bot -> nlu -> core-api).
# Obligatorio si NODE_ENV=production. Mínimo 16 caracteres.
INTERNAL_API_KEY=clave_compartida_entre_servicios_internos

# Ollama local
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
NLU_OLLAMA_TIMEOUT_MS=45000

TIMEZONE=America/Bogota

# Límites defensivos de la superficie HTTP
NLU_MAX_BODY_BYTES=8192
NLU_RATE_LIMIT_MAX=60
NLU_RATE_LIMIT_WINDOW=1 minute

LOG_LEVEL=info
