# apps/telegram-bot — variables que lee este bot.
# Copia a .env.local (ignorado por git) y ajusta.

NODE_ENV=development

# Cuál de los dos bots usar: 'dev' (pruebas, rota entre integrantes) o
# 'demo' (sustentación, no se toca). Cada uno con su token de @BotFather.
TELEGRAM_ENTORNO=dev
TELEGRAM_BOT_TOKEN_DEV=
TELEGRAM_BOT_TOKEN_DEMO=

# Chats con acceso ADMINISTRATIVO (chat_id separados por coma): agenda
# completa, bloquear horario, etc. Cualquier otro chat igual puede consultar
# el catálogo, ver disponibilidad y agendar para sí mismo — ver src/auth.ts.
# Obtené tu chat_id con el comando /id.
TELEGRAM_ALLOWED_CHAT_IDS=

# Servicio NLU
NLU_URL=http://127.0.0.1:8100
INTERNAL_API_KEY=clave_compartida_entre_servicios_internos
BOT_NLU_TIMEOUT_MS=8000
BOT_CONFIANZA_MINIMA=0.55

# n8n: recibe la intención ya confirmada y la reenvía a core-api
# (POST /comandos). El bot nunca le habla a core-api directamente.
N8N_URL=http://127.0.0.1:5678
N8N_COMANDOS_PATH=/webhook/comandos
BOT_N8N_TIMEOUT_MS=15000

# Fase 3 (opcional): tras reservar, se le ofrece al paciente un link para
# sincronizar con SU Google Calendar personal. El bot arma el link, nunca
# habla con Google directamente.
GOOGLE_ADAPTER_URL=http://127.0.0.1:8200

BOT_RATE_LIMIT_POR_MINUTO=20

TIMEZONE=America/Bogota
LOG_LEVEL=info
